NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://schedlane:schedlane@localhost:5432/schedlane
# At least 32 characters (e.g. generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:5173
ORGANIZATION_REQUEST_RATE_LIMIT_MAX=5
PUBLIC_READ_RATE_LIMIT_MAX=120
PUBLIC_WRITE_RATE_LIMIT_MAX=30
EMAIL_PROVIDER=console
RESEND_API_KEY=replace-when-using-resend
EMAIL_FROM="Schedlane <onboarding@resend.dev>"
# Exactly 32 bytes base64-encoded (generate via: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
GUEST_MANAGEMENT_TOKEN_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
