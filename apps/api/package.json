{
  "name": "@schedlane/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/type-provider-typebox": "6.1.0",
    "better-auth": "1.7.2",
    "env-schema": "8.0.0",
    "fastify": "5.12.1",
    "kysely": "0.29.5",
    "pg": "8.23.0",
    "resend": "6.5.2",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "tsx": "4.23.12",
    "vitest": "5.0.0"
  }
}
